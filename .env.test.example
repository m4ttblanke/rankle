# Local Supabase stack only (Milestone 3). Copy to .env.test and fill in from
# `npx supabase status` after `npx supabase start`. NEVER point this at the
# production project — integration/E2E tests write to this database.
#
# .env.test is gitignored; this example file is the only one committed.

# --- Public (matches NEXT_PUBLIC_SUPABASE_* from `supabase status`) ----------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Server-only ---------------------------------------------------------
# Any value >= 16 chars is fine for local testing; this does not need to match
# a production secret.
GUEST_COOKIE_SECRET=test-only-guest-cookie-secret-do-not-reuse

# Milestone 6: the local stack's service-role key (from `supabase status`),
# used by lib/supabase/service-role.ts (claim_guest_submissions only — see
# docs/SECURITY.md sec 26) and by real-auth-user integration tests
# (auth.admin.createUser / generateLink). Local-only value; never production.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Used only by scripts/CLI against the local stack (e.g. resetting between
# runs), never imported by application code.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local Mailpit inbox (from `supabase status`) — e2e tests read real
# magic-link emails from here instead of mocking auth (Milestone 6).
MAILPIT_URL=http://127.0.0.1:54324
