# Copy to .env.local and fill in. Never commit .env.local.
# NEXT_PUBLIC_* values are inlined into the browser bundle — never put a secret
# behind that prefix (docs/SECURITY.md sec 5, sec 18).

# --- Public (safe in the browser) ---------------------------------------------

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (the "sb_publishable_..." key). Public by design;
# access is still gated by Row Level Security. A legacy anon JWT works as the
# value too, but the variable name stays PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute base URL of this app. Defaults to http://localhost:3000 if unset.
NEXT_PUBLIC_APP_URL=

# --- Server-only (NEVER expose to the browser) --------------------------------

# Supabase service-role key. Bypasses RLS — server-only, used only where
# privileged access is genuinely required. Unused as of Milestone 3; leave blank.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the guest identity cookie (Milestone 3; lib/game/guest.ts). Server-only,
# random string, >= 16 chars (32+ recommended). Rotating it logs out every guest
# (their cookie stops verifying) but never widens access to another guest's
# submission. Generate with e.g. `openssl rand -base64 32`.
GUEST_COOKIE_SECRET=

# --- Tooling -----------------------------------------------------------------

# 21st.dev MCP API key (local design tooling only; not used by the app).
API_KEY_21ST=
